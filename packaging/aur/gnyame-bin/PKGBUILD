# Maintainer: Luca Sandrock <luca.sandrock@proton.me>

_name=gnyame
_repository=lsck0/nyangine

pkgname="${_name}-bin"
pkgver=0.0.0
pkgrel=1
pkgdesc='A physics sandbox built on nyangine'
arch=('x86_64')
url="https://github.com/${_repository}"
license=('MIT')
# SDL is linked in and loads the display, audio and input libraries it finds at runtime.
depends=('gcc-libs' 'glibc' 'openssl' 'vulkan-icd-loader')
optdepends=(
    'wayland: native Wayland window'
    'libdecor: window decorations on Wayland compositors without server side ones'
    'libx11: X11 window'
    'libpulse: audio through PulseAudio or pipewire-pulse'
)
provides=("${_name}")
conflicts=("${_name}")
# the integrity check covers the debug sections, so a stripped binary refuses to start.
options=('!strip' '!debug')
source=("${url}/releases/download/v${pkgver}/${_name}.${pkgver}.linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${_name}"
    install -Dm755 "${_name}" "${pkgdir}/usr/bin/${_name}"
    install -Dm644 "${_name}.desktop" "${pkgdir}/usr/share/applications/${_name}.desktop"
    install -Dm644 "${_name}.png" "${pkgdir}/usr/share/icons/hicolor/48x48/apps/${_name}.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
