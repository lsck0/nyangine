Checks:
  [
    clang-diagnostic-*,
    bugprone-*,
    cert-*,
    clang-analyzer-*,
    concurrency-*,
    linuxkernel-*,
    misc-*,
    modernize-*,
    performance-*,
    portability-*,
    readability-*,

    -bugprone-assignment-in-if-condition,
    -bugprone-easily-swappable-parameters,
    -bugprone-inc-dec-in-conditions,
    -bugprone-multi-level-implicit-pointer-conversion,
    -bugprone-multiple-statement-macro,
    -bugprone-narrowing-conversions,
    -bugprone-reserved-identifier,
    # new in clang-tidy 23. A C enum constant is an int, so every OR of flag enumerators trips it, even
    # `1ULL << 0` once it is an enumerator; the fix would be a cast at each of them, which hides real ones.
    -bugprone-signed-bitwise,
    -bugprone-signal-handler,
    -bugprone-suspicious-include,
    -bugprone-suspicious-missing-comma,
    -bugprone-tagged-union-member-count,
    -cert-dcl37-c,
    -cert-dcl51-cpp,
    -cert-exp42-c,
    -cert-int09-c,
    -cert-msc54-cpp,
    -cert-sig30-c,
    -clang-analyzer-optin.performance.Padding,
    -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
    -concurrency-mt-unsafe,
    -misc-confusable-identifiers,
    -misc-include-cleaner,
    -misc-no-recursion,
    -modernize-macro-to-enum,
    -modernize-redundant-void-arg,
    -modernize-use-nullptr,
    -performance-no-int-to-ptr,
    -portability-avoid-pragma-once,
    -readability-avoid-nested-conditional-operator,
    -readability-braces-around-statements,
    -readability-enum-initial-value,
    -readability-function-cognitive-complexity,
    -readability-function-size,
    -readability-identifier-length,
    -readability-implicit-bool-conversion,
    -readability-isolate-declaration,
    -readability-magic-numbers,
    -readability-math-missing-parentheses,
    -readability-non-const-parameter,
    -readability-redundant-control-flow,
    -readability-suspicious-call-argument,
    # new in clang-tidy 23. Where an initializer breaks is clang-format's call, and the tree never adopted
    # a trailing-comma rule; its default also strips the comma from one-line initializers.
    -readability-trailing-comma,
  ]
WarningsAsErrors: ""
HeaderFilterRegex: "^.*/src/(nyangine|gnyame|build)/.*"
