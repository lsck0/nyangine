# generated
#
# The asset index and the string table are committed so a fresh clone builds. The blob is not:
# it is the whole asset tree as a byte array.
src/genyarated/assets.c
assets/shader/compiled/

# binaries
#
# Anchored to the repo root with a leading slash: every one of these is produced next to build.c,
# and unanchored patterns like *.so or *.lib would also swallow anything vendored or nested.
dist/
/build
/.backup_build_executable*

# debug, developer and test artifacts, per mode and per platform. Hot reload means an exe, a shared
# library and (on windows) an import library and the copy the loader actually opens.
/*.debug
/*.debug.so
/*.debug.exe
/*.debug.dll
/*.debug.lib
/*.debug.loaded.*.dll
/*.dev
/*.dev.so
/*.dev.exe
/*.dev.dll
/*.dev.lib
/*.dev.loaded.*.dll
/*.test

# `./build run example <name>` builds examples/<name>/main.c to <name>.example at the root, so the
# rpath in FLAGS_LINUX_X86_64 ($ORIGIN) finds the vendored shared objects.
/*.example
/*.example.exe

# release
/*.linux-x86_64
/*.windows-x86_64.exe

# steam, a directory each: the executable and the Steamworks library beside it
/*.steam-linux-x86_64/
/*.steam-windows-x86_64/

# vendor build trees
#
# Every vendor configures into vendor/<name>/build-<target>/ and nothing in there is ours. They also
# must never be committed: a cmake cache records absolute paths to the compiler and make program, so
# a tree built on one machine breaks the build on any other.
vendor/*/build-*/

# the Steam Runtime SDK sysroot, which `./build build steam-linux` downloads
vendor/steamrt/

# debug data
perf*

# doxygen, and the assembled docs site `./build docs` stages. Both are generated: the site is a fresh
# copy of the hand-written docs/ tree with the generated cheatsheet and the doxygen HTML dropped in, so
# only the sources under docs/ are committed and the deploy pipeline runs `./build docs` to rebuild it.
docs/doxygen/
/site/

# keep
!src/build/

# Coverage profiles and merged data from `./build run coverage`.
.coverage/

# Daily log files written by nya_log_directory_open, pruned to NYA_LOG_RETENTION_DAYS.
/logs/

# Benchmark binaries, built next to their source by `./build run bench`.
bench/*
!bench/*.c

# Compiled test binaries. `./build run test` builds tests/**/test_foo next to tests/**/test_foo.c, so
# these are artifacts sitting in the source tree rather than beside it — the negation is what keeps the
# sources, since git cannot match "has no extension".
tests/**/test_*
!tests/**/test_*.c

# The one test database that is kept on purpose: tests/nyangine/db/test_db_migrate.c reopens the file
# the previous run of the suite wrote, because a schema that has never survived a restart has not been
# shown to survive one.
/_test_db_reopen.db

# Objects the split compile and link rules write, see OBJECT_DIRECTORY in src/build/flags.h.
/.objects/

# Where `./build run fuzz` puts the instrumented binaries and afl-fuzz's own findings directory. The
# inputs worth keeping are copied by hand into tests/fuzz/corpus and tests/fuzz/crashes, which are.
/.fuzz/

# Where packaging/steam/upload.sh assembles the depots for steamcmd.
/.steam-upload/

# Plaintext secrets.
#
# Everything under secrets/ is committed *encrypted*, so the rule is inverted there: refuse the key
# and certificate extensions outright, and let the .enc and .yaml sops produces through. This is a
# backstop and not the check that matters; see secrets/README.md.
secrets/**/*.pfx
secrets/**/*.p12
secrets/**/*.key
secrets/**/*.pem
secrets/**/*.jks
secrets/**/*.keystore
!secrets/**/*.enc
!secrets/**/*.example
