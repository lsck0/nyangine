CompileFlags:
  Compiler: clang
  Add:
    [
      -xc,
      -std=c2y,
      -mavx,
      -mavx2,
      -fdefer-ts,
      -fenable-matrix,
      -Wall,
      -Wdangling-else,
      -Wduplicated-branches,
      -Wduplicated-cond,
      -Wextra,
      -Wimplicit-fallthrough,
      -Wlogical-op,
      -Wnull-dereference,
      -Wodr,
      -Wpointer-arith,
      -Wrestrict,
      -Wshadow,
      -Wstrict-prototypes,
      -Wswitch,
      -Wswitch-default,
      -Wvla,
      -Wno-empty-translation-unit,
      -Wno-gcc-compat,
      -Wno-gnu,
      -Wno-initializer-overrides,
      -Wno-keyword-macro,
      -DDEBUG=true,
      -DNYA_EXECUTION_MODE=0,
      -DNYA_ASSET_PREFER_BLOB,
      -DNYA_ASSET_HOT_RELOAD,
      # The plugins the project actually compiles, mirroring FLAGS_PLUGINS in src/build/flags.h.
      #
      # Without these every plugin source is an empty translation unit as far as clangd is concerned
      # — no diagnostics, no completion, no rename coverage — which is the same failure the headless
      # fragment below was added to fix. Three whole modules were being edited blind.
      # The optional modules, mirroring FLAGS_MODULES: without it the whole db module is empty here.
      -DNYA_MODULE_DB,
      -DNYA_MODULE_TLS,
      -DNYA_PLUGIN_CURL,
      -DNYA_PLUGIN_DISCORD,
      -DNYA_PLUGIN_LUA,
      # The game's plugin permission profile, mirroring FLAGS_PLUGIN_PERMISSIONS in src/build/flags.h.
      # 2 is NYA_PLUGIN_PERMISSION_PROFILE_GAMEPLAY; without it the editor analyses core_plugin.c under
      # a different grant than the build and its #if arms disagree with the binary.
      -DNYA_PLUGIN_PERMISSION_PROFILE=2,
      # What the sqlite plugin's extensions compile against. From the vendor rules, not invented here.
      -DSQLITE_CORE,
      -DSQLITE_VEC_STATIC,
      # The physics vendors' world limits and ufbx's compiled out features, from the same rules. The
      # lint rule in src/build/lint.c found these missing, which is what it is for.
      -DB2_MAX_WORLDS=8,
      -DB3_MAX_WORLDS=8,
      -DUFBX_NO_SCENE_EVALUATION,
      -DUFBX_NO_SUBDIVISION,
      -DUFBX_NO_TESSELLATION,
      -I/home/luca/projects/nyangine/,
      -I/home/luca/projects/nyangine/src/,
      -I/home/luca/projects/nyangine/vendor/,
      -I/home/luca/projects/nyangine/vendor/sdl/include/,
      -I/home/luca/projects/nyangine/vendor/sdl-image/include/,
      -I/home/luca/projects/nyangine/vendor/sdl-ttf/include/,
      -I/home/luca/projects/nyangine/vendor/sdl-mixer/include/,
      -I/home/luca/projects/nyangine/vendor/box2d/include/,
      -I/home/luca/projects/nyangine/vendor/box3d/include/,
      -I/home/luca/projects/nyangine/vendor/curl/include/,
      -I/home/luca/projects/nyangine/vendor/lua/src/,
      -I/home/luca/projects/nyangine/vendor/lz4/lib/,
      -I/home/luca/projects/nyangine/vendor/monocypher/src/,
      -I/home/luca/projects/nyangine/vendor/libbacktrace/,
      -I/home/luca/projects/nyangine/vendor/libbacktrace/build-linux-x86_64/,
      -I/home/luca/projects/nyangine/vendor/sqlite/build-linux-x86_64/,
      -I/home/luca/projects/nyangine/vendor/sqlean/src,
      -I/home/luca/projects/nyangine/vendor/sqlvec,
      -I/home/luca/projects/nyangine/vendor/ufbx,
    ]

Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    Add:
      [
        bugprone-*,
        cert-*,
        clang-analyzer-*,
        concurrency-*,
        linuxkernel-*,
        misc-*,
        modernize-*,
        performance-*,
        portability-*,
        readability-*,
      ]
    # This list mirrors the disables in .clang-tidy. clangd reads .clang-tidy, but the `Add:` above
    # re-enables whole groups on top of it, which silently resurrects anything .clang-tidy turned
    # off inside one of those groups — the editor showed modernize-redundant-void-arg while
    # `./build check` did not. Adding a disable to .clang-tidy alone is therefore not enough; it
    # goes in both.
    #
    # Four of .clang-tidy's disables are deliberately absent here, because naming them makes clangd
    # itself warn: it does not register clang-analyzer-optin.performance.Padding or
    # clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling at all, and it has no
    # latency data for bugprone-tagged-union-member-count or portability-avoid-pragma-once, so those
    # two never run under the default FastCheckFilter anyway. Leaving them out is what keeps this
    # file warning-free; .clang-tidy still disables all four for the command line run.
    Remove:
      [
        bugprone-assignment-in-if-condition,
        bugprone-easily-swappable-parameters,
        bugprone-inc-dec-in-conditions,
        bugprone-multi-level-implicit-pointer-conversion,
        bugprone-multiple-statement-macro,
        bugprone-narrowing-conversions,
        bugprone-reserved-identifier,
        bugprone-signal-handler,
        bugprone-suspicious-include,
        bugprone-suspicious-missing-comma,
        cert-dcl37-c,
        cert-dcl51-cpp,
        cert-exp42-c,
        cert-int09-c,
        cert-msc54-cpp,
        cert-sig30-c,
        concurrency-mt-unsafe,
        misc-confusable-identifiers,
        misc-include-cleaner,
        misc-no-recursion,
        modernize-macro-to-enum,
        modernize-redundant-void-arg,
        modernize-use-nullptr,
        performance-no-int-to-ptr,
        readability-avoid-nested-conditional-operator,
        readability-braces-around-statements,
        readability-enum-initial-value,
        readability-function-cognitive-complexity,
        readability-function-size,
        readability-identifier-length,
        readability-implicit-bool-conversion,
        readability-isolate-declaration,
        readability-magic-numbers,
        readability-math-missing-parentheses,
        readability-non-const-parameter,
        readability-redundant-control-flow,
        readability-suspicious-call-argument,
      ]

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# PER PATH FRAGMENTS
#
# The block above describes a normal debug build of the engine: windowed, SDL present, hot reload on.
# That is the right default because it is what most of the tree compiles as — but three parts of the
# tree do not compile that way, and until these fragments existed clangd analysed them under flags
# they are never actually built with. The effect is not subtle: a file behind an #if that is false in
# the default config gets no diagnostics, no completion and no rename coverage at all, so a signature
# change sails straight through it. Renaming a font parameter broke render2d_headless.c twice in
# one session without a single squiggle, because clangd had never once parsed it.
#
# clangd applies every fragment whose If matches, in order, on top of the base block above.
# ─────────────────────────────────────────────────────────────────────────────────────────────────

---
# The headless halves of the renderer: whole files that only exist when NYA_HEADLESS is defined, and
# are therefore dead text without it. See NYA_HEADLESS_ENABLED in base_basic.h.
#
# Matched by filename rather than listed one by one, so a new *_headless.c is covered the day it is
# written rather than the day someone remembers this file.
If:
  PathMatch: .*_headless\.c

CompileFlags:
  Add: [-DNYA_HEADLESS]

---
# The Windows halves of the platform layer. Linux builds everything, this machine included, so these
# files are compiled every day — but only ever through `--target=x86_64-w64-mingw32`. Analysed as
# Linux translation units they cannot find <windows.h> at all, so the whole file is one fatal error
# and clangd reports nothing else in it: no diagnostics, no completion, no rename coverage, exactly
# the failure the headless fragment below was written for.
#
# The triple alone is enough; clang finds the distro mingw-w64 sysroot at /usr/x86_64-w64-mingw32
# without --sysroot. The intrinsics define mirrors NYA_MINGW_INTRINSICS in
# src/build/on_linux/toolchain.h:16 and must stay equal to it.
If:
  PathMatch: .*_windows\.c

CompileFlags:
  Add: [--target=x86_64-w64-mingw32, -D__INTRINSIC_DEFINED___cpuidex]

---
# Tests build headless, with assertions and nya_expect_crash live. Analysing them as an ordinary
# debug build gets NYA_TESTING wrong, which is what gates the crash-expectation machinery.
If:
  PathMatch: tests/.*

CompileFlags:
  Add: [-DNYA_HEADLESS, -DNYA_TESTING, -DNYA_EXECUTION_MODE=4]

---
# The build system is a host tool: core and renderer are compiled out entirely rather than stubbed,
# so nearly every engine header behaves differently here than anywhere else in the tree.
If:
  PathMatch: src/build/.*

CompileFlags:
  Add: [-DNYA_NO_SDL]
