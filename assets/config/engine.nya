// Starter values for GNY_Config, loaded by gny_world_create and — in a hot reload build — watched
// from then on. Edit a number and save; the running game picks it up within one asset stat interval.
// See src/gnyame/config.h and src/nyangine/core/core_config.h for what each field means.
//
// The checksum in the header below is not checked on load (NYA_SERDE_NO_CHECKSUM): this file is meant
// to be hand edited, unlike a save.
nya 2 0
{
    engine: object {
        renderer: object {
            // See NYA_RENDER3D_SHADOW_BIAS.
            shadow_bias: f32 0.0015;
            // See NYA_Render3DShadowOptions. Each cascade is a scene pass.
            shadow_cascades: u32 2;
            // Texels per cascade side, a power of two. See NYA_Render3DShadowOptions.
            shadow_map_size: u32 1024;
            // The hue shade leans toward, alpha as how far; a = 0 keeps plain darkening.
            shadow_color: object { r: f32 0.42; g: f32 0.50; b: f32 0.95; a: f32 0.25; };
            // The post passes, read by the 3D demo every frame. A field left out or zero takes its
            // NYA_POST_* default; see render_post.h. Ink outlines are there for a drawn look; off here.
            ink: object {
                enabled: b8 false;
                width: f32 2.0;
                crease: f32 40.0;
                fade_start: f32 25.0;
                fade_end: f32 90.0;
            };
            ambient_occlusion: object {
                enabled: b8 true;
                radius: f32 0.75;
                // Pixels, so contact shading reads however far away the camera is.
                min_radius: f32 32.0;
                strength: f32 0.35;
                // A soft gradient rather than a band: band sits mid way and softness spans it.
                band: f32 0.4;
                softness: f32 0.4;
            };
            antialias: object {
                enabled: b8 true;
            };
            // NYA_POST_FOCUS_OFF, _TILT_SHIFT or _DISTANCE. A zero focus_distance follows the cube in the 3D demo.
            depth_of_field: object {
                focus: string "NYA_POST_FOCUS_OFF";
                band_offset: f32 0.05;
                focus_range: f32 1.5;
            };
            // The most the 3D demo draws, scaled by how fast the camera moves. Zero is off.
            speed_lines: object {
                amount: f32 0.0;
            };
            // A zero field keeps the scene's own number. See NYA_PostBloom; b toggles it in both scenes.
            bloom: object {
                enabled: b8 true;
            };
            // Eyes getting used to the dark and the light. See NYA_PostEyeAdaptation.
            eye_adaptation: object {
                enabled: b8 true;
                key: f32 0.45;
                exposure_min: f32 0.75;
                exposure_max: f32 1.6;
                dark_seconds: f32 2.5;
                bright_seconds: f32 0.6;
                saturation: f32 0.2;
            };
            // Rays of sky light fanning out from the sun past the terrain's silhouette. See NYA_PostLightShafts.
            light_shafts: object {
                enabled: b8 true;
                intensity: f32 0.35;
                length: f32 0.9;
                threshold: f32 0.85;
            };
            // Camera motion blur. The player's graphics settings keep it off until turned on. See NYA_PostMotionBlur.
            motion_blur: object {
                enabled: b8 true;
                strength: f32 0.5;
            };
            // The 3D demo's fog; a zero field keeps the sky's colour and the scene's numbers. aerial turns distant
            // ground toward the sky's hue before the fog covers it. See NYA_Render3DFog.
            fog: object {
                aerial: f32 0.75;
            };
            // The 2D background's haze between its hills, in the sky's colour unless one is set. See NYA_Render2DHaze.
            haze: object {
                density: f32 0.12;
                falloff: f32 0.7;
            };
            // See NYA_Render3DDecals.
            decals: object {
                enabled: b8 true;
            };
            // HDR where the display offers it. See NYA_RenderOutput.
            output: object {
                hdr: b8 false;
                peak: f32 2.5;
            };
            // NYA_POST_DEBUG_VIEW_NONE, _NORMALS, _DEPTH, _OCCLUSION, _INK or _CASCADES.
            debug_view: string "NYA_POST_DEBUG_VIEW_NONE";
            // A .cube colour lookup table, or "" for none. assets/grades/identity.cube changes nothing.
            grade_lut: string "./assets/grades/vivid.cube";
            // How much of the grade applies. Zero skips the pass.
            grade_strength: f32 0.4;
        };
        physics: object {
            // Metres per second squared. See NYA_PHYSICS3D_GRAVITY_DEFAULT.
            gravity: f32 9.81;
            // See NYA_PHYSICS2D_SUB_STEPS / NYA_PHYSICS3D_SUB_STEPS.
            sub_steps: u32 4;
        };
        audio: object {
            // How sound travels, traced against the physics world: hidden sounds dull and bend around
            // edges, the room around the ear sets the reverb, and nearby surfaces echo. The 3D demo's
            // voices. A zero field takes its NYA_AUDIO_PROPAGATION_* default; see core_audio_propagation.h.
            propagation: object {
                enabled: b8 true;
                ray_budget: u32 64;
                diffraction: b8 true;
                diffraction_reach: f32 3.0;
                environment: b8 true;
                environment_range: f32 40.0;
                reflections: f32 0.2;
            };
            // Each bus's effects, a unit left out is off. See NYA_AudioEffects in core_audio_effects.h.
            sound: object {
                compressor: object {
                    enabled: b8 true;
                    threshold_db: f32 -12.0;
                    ratio: f32 3.0;
                };
            };
            // Nothing past the ceiling however many crates land at once.
            master: object {
                limiter: object {
                    enabled: b8 true;
                    ceiling_db: f32 -1.0;
                };
            };
        };
        // The menus and HUD panels. A field left out or zero takes its NYA_UI_* default, which is flat and quiet;
        // outline, depth and pop dress it up. Sizes are pixels in a 720 tall window, scaled with the window. See ui.h.
        ui: object {
            // A registered font name for the face, see gny_fonts_register, and the text sizes cut from it.
            font: string "menu";
            title_font: string "menu_title";
            // Focus and press fade, and a panel slides in when it shows. Zero for either turns it off.
            transition_s: f32 0.08;
            appear_s: f32 0.15;
            easing: string "NYA_EASE_CUBIC_OUT";
            body_size: f32 22.0;
            small_size: f32 17.0;
            title_size: f32 44.0;
            // Regions of a sheet for nine-slices. With no texture they stay flat; game.menu_sheet names one for the pause menu.
            // A white tint draws the sheet's own colours; a zero one tints it with the flat colour, as the track does
            // to fill a slider with the accent.
            panel_skin: object { source_width: f32 24.0; source_height: f32 24.0; left: f32 7.0; right: f32 7.0; top: f32 7.0; bottom: f32 7.0; tint: object { r: f32 1.0; g: f32 1.0; b: f32 1.0; a: f32 1.0; }; };
            button_skin: object {
                normal: object { source_x: f32 24.0; source_width: f32 24.0; source_height: f32 24.0; left: f32 5.0; right: f32 5.0; top: f32 5.0; bottom: f32 5.0; tint: object { r: f32 1.0; g: f32 1.0; b: f32 1.0; a: f32 1.0; }; };
                focused: object { source_x: f32 48.0; source_width: f32 24.0; source_height: f32 24.0; left: f32 5.0; right: f32 5.0; top: f32 5.0; bottom: f32 5.0; tint: object { r: f32 1.0; g: f32 1.0; b: f32 1.0; a: f32 1.0; }; };
                pressed: object { source_x: f32 72.0; source_width: f32 24.0; source_height: f32 24.0; left: f32 5.0; right: f32 5.0; top: f32 5.0; bottom: f32 5.0; tint: object { r: f32 1.0; g: f32 1.0; b: f32 1.0; a: f32 1.0; }; };
                disabled: object { tint: object { r: f32 0.55; g: f32 0.55; b: f32 0.55; a: f32 1.0; }; };
            };
            track_skin: object { source_y: f32 24.0; source_width: f32 16.0; source_height: f32 16.0; left: f32 5.0; right: f32 5.0; top: f32 5.0; bottom: f32 5.0; };
            knob_skin: object { source_x: f32 16.0; source_y: f32 24.0; source_width: f32 16.0; source_height: f32 16.0; tint: object { r: f32 1.0; g: f32 1.0; b: f32 1.0; a: f32 1.0; }; };
        };
    };
    game: object {
        // The sheet the pause menu is skinned from, cut by the regions in engine.ui: "./assets/ui/sheet.png". Empty draws it flat.
        menu_sheet: string "";
        // See GNY_PLAYER_SPEED.
        player_speed: f32 220.0;
        // See GNY_PLAYER_SPAWN_SPACING.
        player_spawn_spacing: f32 64.0;
        // See GNY_ANIMATION_SPEED.
        animation_speed: f32 1.0;
        // The learning drones in the 2D scene. See src/gnyame/robots.h.
        robots: object {
            enabled: b8 true;
            // Genomes per generation, read when training starts.
            population: u32 48;
            // What training may cost: both run on one job every quarter second.
            generations_per_second: f32 2.0;
            dqn_steps_per_second: f32 240.0;
            show_brain: b8 true;
        };
    };
}
