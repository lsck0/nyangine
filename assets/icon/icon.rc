#include <windows.h>

// the NYA_RC_* values come from build_windows_resources, as bare tokens: windres runs its
// preprocessor through a shell that strips quotes.
#define NYA_RC_STRING_(x) #x
#define NYA_RC_STRING(x)  NYA_RC_STRING_(x)

IDI_ICON1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    NYA_RC_VERSION_MAJOR, NYA_RC_VERSION_MINOR, NYA_RC_VERSION_PATCH, 0
PRODUCTVERSION NYA_RC_VERSION_MAJOR, NYA_RC_VERSION_MINOR, NYA_RC_VERSION_PATCH, 0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", NYA_RC_STRING(NYA_RC_NAME)
            VALUE "FileVersion", NYA_RC_STRING(NYA_RC_VERSION)
            VALUE "ProductName", NYA_RC_STRING(NYA_RC_NAME)
            VALUE "ProductVersion", NYA_RC_STRING(NYA_RC_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
